# ============================================================
#  Coursera MIP — Frontend (Next.js)
#  Copy to  frontend/.env.local  and set the backend URL.
#  NEXT_PUBLIC_* values are exposed to the browser (not secret).
# ============================================================

# Base URL of the backend API (no trailing slash).
# Local:      http://localhost:8000
# Deployed:   https://your-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Axios request timeout in ms. Default 300000 (5 min) for long LLM/ingestion calls.
NEXT_PUBLIC_API_TIMEOUT=300000
