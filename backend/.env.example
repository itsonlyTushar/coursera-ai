# ============================================================
#  Coursera MIP — Backend (API + bundled ingestion pipeline)
#  Copy this file to  backend/.env  and fill in your credentials.
#  This ONE file powers the API, the Ask/RAG path, and /api/ingest.
# ============================================================

# ---- Vector store: Qdrant  [REQUIRED] ----
QDRANT_URL=https://your-qdrant-cluster-url
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=COURSEERA_ALMAX_MULTIMODAL
QDRANT_DISTANCE=Cosine

# ---- Embeddings: BGE via Hugging Face Inference API  [REQUIRED] ----
# A single HF token with Inference-API access covers both retrieval and ingestion.
HF_TOKEN=your-huggingface-token
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSIONS=768
# Optional local cache dir for HF libs:
HF_HOME=.cache/huggingface

# ---- LLM synthesis: Groq  [REQUIRED for Ask] ----
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# ---- Reranking: Cohere  [REQUIRED for Ask retrieval] ----
COHERE_API_KEY=your-cohere-api-key

# ---- Visual analysis: Google Gemini  [REQUIRED for ingestion /api/ingest] ----
GEMINI_API_KEY=your-gemini-api-key

# ---- Persistence & dashboard: Supabase  [REQUIRED] ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-backend-secret-key

# ---- Web / CORS / runtime ----
# Comma-separated list of allowed frontend origins:
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://coursera-mip.vercel.app
LOG_LEVEL=INFO
# Local dev only (ignored on hosts that inject $PORT, e.g. Render):
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
