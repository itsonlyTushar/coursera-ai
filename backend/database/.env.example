# ============================================================
#  Ingestion pipeline env — STANDALONE BATCH RUNS ONLY.
#
#  The live backend (API + /api/ingest) reads backend/.env — you do NOT need
#  this file to run the app. Create backend/database/.env only if you run the
#  offline whole-course batch pipeline directly from this folder
#  (e.g. `python -m src.embeddings`, `python -m src.qdrant_db`).
# ============================================================

GEMINI_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=COURSEERA_ALMAX_MULTIMODAL

# Hugging Face token — API-based text embeddings + the private visual dataset.
HF_TOKEN=

# Supabase (only used by the batch-side src/supabase_db.py helper).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
